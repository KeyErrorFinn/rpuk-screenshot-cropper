{
    "name": "rpuk-screenshot-cropper",
    "version": "2.0.2",
    "type": "module",
    "description": "A local desktop utility for cropping, organising and sharing game screenshots.",
    "author": "RPUK Screenshot Cropper Contributors",
    "main": "./out/main/index.js",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "test": "node --test tests/*.test.js",
        "test:ui": "vitest run --config vitest.config.js",
        "test:e2e": "npm run build:unpack && playwright test --config playwright.config.js",
        "start": "electron-vite --config ./vite.config.ts preview",
        "dev": "electron-vite --config ./vite.config.ts dev",
        "build": "electron-vite --config ./vite.config.ts build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@hookform/resolvers": "^5.2.1",
        "electron-store": "^10.1.0",
        "lucide-react": "^0.542.0",
        "react-hook-form": "^7.62.0",
        "sharp": "^0.34.5",
        "sonner": "^2.0.7",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.0.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.1.12",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.21",
        "baseline-browser-mapping": "^2.11.23",
        "electron": "^37.2.3",
        "electron-builder": "^25.1.8",
        "electron-vite": "^4.0.0",
        "eslint": "^9.31.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "sass-embedded": "^1.91.0",
        "tailwindcss": "^4.1.12",
        "vite": "^7.0.5",
        "vitest": "^5.0.0"
    }
}
